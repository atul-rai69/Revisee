ENVIRONMENT=development
REVISEE_DEBUG=false
DATABASE_URL=postgresql+psycopg://revisee_user:replace_me@localhost:5432/revisee
TEST_DATABASE_URL=postgresql+psycopg://revisee_test_user:replace_me@localhost:5432/revisee_test

SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
SESSION_EXPIRE_MINUTES=30

GOOGLE_API_KEY=replace_with_google_api_key
GEMINI_MODEL=gemini-2.5-flash

# Phase 2A AI safety limits. These can be tuned without a schema migration.
AI_GENERATION_ENABLED=true
AI_MAX_SOURCE_CHARACTERS=8000
AI_MAX_THEORY_CHARACTERS=6000
AI_MAX_KEY_POINT_CHARACTERS=2000
AI_MAX_NOTES_CHARACTERS=8000
AI_MAX_PROMPT_CHARACTERS=12000
AI_MAX_RAW_RESPONSE_CHARACTERS=40000
AI_MAX_OUTPUT_TOKENS=4800
AI_MAX_QUESTIONS_PER_CALL=10
AI_MAX_SOURCE_ITEMS_PER_OPERATION=5
AI_PROVIDER_TIMEOUT_SECONDS=20
AI_OPERATION_DEADLINE_SECONDS=120
AI_PROVIDER_ATTEMPTS=2
AI_MAX_EXPECTED_TIME_SECONDS=3600

CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

CORS_ORIGINS=["http://localhost:4200","http://localhost:40211"]
